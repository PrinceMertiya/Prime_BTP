managed implementation in class zbp_prime_i_hdr_1 unique;
strict ( 2 );
with draft;


define behavior for ZPrime_I_HDR_1 //alias <alias_name>
draft table zprime_dt_1
persistent table zprime_hdr_1
lock master total etag LocalLastChangedAt
authorization master ( instance )
early numbering
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) ReqId,
  Status,
  TotalAmount,
  RejectReason,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;


  action ( features : instance ) Approve result [1] $self;
  action ( features : instance ) Reject
    parameter ZPS_AB_REJECT
    result [1] $self;

  action ( features : instance ) Submit result [1] $self;
  action CopyRequest result [1] $self;

  determination CalculateStatus
  on modify { field TotalAmount; }

  side effects
  {
    entity _Item affects field TotalAmount, field Status;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
    draft determine action Prepare
  {
    validation ZPrime_I_ITME_1~validateItemData;
  }


  association _Item { create; with draft; }

  mapping for zprime_hdr_1{

    ReqId              = req_id;
    ReqType            = req_type;
    Vendor             = vendor;
    Status             = status;
    Category           = category;
    RejectReason       = reject_reason;
    CukyField          = cuky_field;
    TotalAmount        = total_amount;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;

  }
}

define behavior for ZPrime_I_ITME_1 //alias <alias_name>
persistent table zprime_item_1
draft table zprime_dt_Item1
lock dependent by _Header
authorization dependent by _Header
early numbering
etag master LocalLastChangedAt

{
  update;
  delete;
  field ( readonly ) ReqId, ItemId, Amount;
  association _Header { with draft; }

  validation validateItemData on save { create; update; }


  determination CalculatingAmount
  on modify { field Quantity; field Price; }

  determination CalculateTotalAmount
  on modify { create; delete; field Amount; }


  side effects
  {
    field Quantity affects field Amount, entity _Header;
    field Price affects field Amount, entity _Header;
  }

  mapping for zprime_item_1{
    ReqId              = req_id;
    ItemId             = item_id;
    Material           = material;
    Quantity           = quantity;
    Price              = price;
    Amount             = amount;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}