managed;// implementation in class zbp_sls_i_order_hdr unique;
//strict ( 2 );

define behavior for zpsls_i_order_hrh //alias <alias_name>
persistent table zpsls_order_hrh
lock master

etag master LastChangedAt
{

  create;
  update;
  delete;

  field ( readonly )
    CreatedBy,
    CreatedAt,
    LastChangedAt;

  mapping for zpsls_order_hrh
  {
    OrderId      = order_id;
    OrderName    = order_name;
    OrderType    = order_type;
    OrderDate    = order_date;
    Status       = status;
    CukyField    = cuky_field;
    Amount       = amount;
    CreatedBy    = created_by;
    CreatedAt    = created_at;
    LastChangedAt = last_changed_at;
  }

}

