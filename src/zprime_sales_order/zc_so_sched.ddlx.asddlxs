@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Delivery Schedule',
    typeNamePlural: 'Delivery Schedules',
    title: { type: #STANDARD, value: 'SchedId' },
    description: { type: #STANDARD, value: 'DeliveryDate' }
  }
}
annotate view ZC_SO_SCHED with
{
  @UI.facet: [
    { id: 'SchedInfo',     purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Schedule Details', position: 10 },
    { id: 'HandlingUnits', purpose: #STANDARD, type: #LINEITEM_REFERENCE,       label: 'Handling Units',   position: 20, targetElement: '_Hu' }
  ]

  @EndUserText.label: 'Schedule ID'
  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  SchedId;

  @EndUserText.label: 'Delivery Date'
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  DeliveryDate;

  @EndUserText.label: 'Plant'
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  Plant;

  @EndUserText.label: 'Confirmed Quantity'
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  ConfirmedQty;

  @EndUserText.label: 'Unit of Measure'
  @UI: { lineItem: [{ position: 45 }], identification: [{ position: 45 }] }
  Uom;

  @EndUserText.label: 'Schedule Weight'
  @UI: { lineItem: [{ position: 50 }], identification: [{ position: 50 }] }
  SchedWeight;

  @EndUserText.label: 'Weight Unit'
  @UI: { identification: [{ position: 55 }] }
  WeightUnit;
}