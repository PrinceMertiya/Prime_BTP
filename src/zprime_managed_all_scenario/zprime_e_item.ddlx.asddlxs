@Metadata.layer: #CORE

annotate entity ZC_PRIME_ITEM
with
{

  @UI.facet: [
    {
      id: 'ItemDetails',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Item Details',
      position: 10
    }
  ]

  @UI: {
      lineItem: [ { position: 10 } ],
      identification: [ { position: 10 , label: 'Item Id' } ]
  }
  ItemId;

  @UI: {
      lineItem: [ { position: 20 } ],
      identification: [ { position: 20 , label: 'Material' } ]
  }
  Material;

  @UI: {
      lineItem: [ { position: 30 } ],
      identification: [ { position: 30 , label: 'Quantity' } ]
  }
  Quantity;

  @UI: {
      lineItem: [ { position: 40 } ],
      identification: [ { position: 40 , label: 'Price' } ]
  }
  Price;

  @UI: {
      lineItem: [ { position: 50 } ],
      identification: [ { position: 50 , label: 'Amount' } ]
  }
  Amount;

}