projection;
strict( 2 );
use draft;
use side effects;

define behavior for ZC_PRIME_HDR
{
  use create;
  use update;
  use delete;

  use action Prepare;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;

  use action Submit;
  use action CopyRequest;

  use action Approve;
use action Reject;

  use association _Item
{
   create;

}

}

define behavior for ZC_PRIME_ITEM
{
  use update;
  use delete;

  use association _Header;
}